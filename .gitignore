# --------------------------------------------------------------------------- #
# Policy: the repository publishes the MODELING FRAMEWORK, THE PIPELINE STAGES
# and the DATA-RETRIEVAL LAYER (sources/). The data itself - databases and
# caches (input/, output/, *.parquet) - plus development notebooks and
# generated artifacts stay local. Results are published on the companion
# website, not here.
# --------------------------------------------------------------------------- #

# Secrets (FRED key etc.) - never commit
**/.env
*.pem
*.key

# Environments / caches
.venv/
.venv-macos/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
**/.cache/

# Editor / OS / assistant
.DS_Store
.claude/

# Data layer: the retrieval code in sources/ IS versioned; the data it pulls
# is not (provider licensing). Caches and databases stay local.
input/
**/input/
output/
**/output/
*.parquet
*.xlsx
*.xls
*.dta
*.db
*.sqlite

# Development notebooks (production runs pure .py; notebooks are the lab)
notebooks/

# Generated artifacts: published fans, figures, weekly report
products/**/*.csv
products/blocks/bundle.json
products/figures/
products/report.pdf
products/report.md
products/published/
products/latest
products/.latest-tmp
figures/
**/figures/

# LaTeX build artifacts
**/*.aux
**/*.fdb_latexmk
**/*.fls
**/*.log
**/*.out
**/*.synctex.gz

# Tests whose subject is the private data layer stay local
tests/test_data_inei.py

# Teaching side-project (course/): private, not part of the published framework
course/
